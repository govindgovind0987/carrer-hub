# ===========================================
# CareerHub Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/careerhub?schema=public"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Alternatively supported aliases:
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth Provider
# Authorized Homepage URL: http://localhost:3000 (Local) or https://carrer-hub-kappa.vercel.app (Production)
# Authorized callback URL: http://localhost:3000/api/auth/callback/github (Local) or https://carrer-hub-kappa.vercel.app/api/auth/callback/github (Production)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
# Alternatively supported aliases:
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"
# GITHUB_ID="your-github-client-id"
# GITHUB_SECRET="your-github-client-secret"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CareerHub"
